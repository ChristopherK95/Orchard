{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Editor",
  "version": "0.1.0",
  "identifier": "dev.agent-editor.app",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Agent Editor", "width": 1280, "height": 820 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
